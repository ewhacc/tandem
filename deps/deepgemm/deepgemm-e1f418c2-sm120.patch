-    static int get_theoretical_mk_alignment_for_contiguous_layout(const std::optional<int>& expected_m) {
+    // DSV4.1 (vLLM-Moet): SM120 per-group BLOCK_M (nv_dev's policy, not carried by the port
+    // of the SM120 kernels): BLOCK_M in {64, 128} (kMWarps(4) x MMA_M(16)); pad each
+    // group of the contiguous grouped layout to the smallest tile covering its expected
+    // rows (MoE decode: 64) instead of the legacy 128, which doubles the grouped GEMM time.
+    static int get_theoretical_mk_alignment_for_contiguous_layout(const std::optional<int>& expected_m,
+                                                                    const std::optional<int>& num_groups = std::nullopt) {
+        if (jit->device.get_arch_major() == 12) {
+            int block_m = 128;
+            if (expected_m.has_value()) {
+                int per_group_m = expected_m.value();
+                if (num_groups.has_value() and num_groups.value() > 0)
+                    per_group_m = (per_group_m + num_groups.value() - 1) / num_groups.value();
+                for (; block_m > 64 and block_m - 64 >= per_group_m; block_m -= 64);
+            }
+            return block_m;
+        }
         if (jit->device.get_arch_major() != 10)
             return kLegacyMKAlignmentForContiguousLayout;
 
